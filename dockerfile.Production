# Stage 1: Build stage
FROM node:20-alpine AS builder
WORKDIR /app

# Hem package.json hem de güncellediğimiz package-lock.json imaja kopyalanıyor
COPY package*.json ./

# Tam kilit uyumuyla kararlı ve hızlı kurulum (npm install yerine npm ci)
RUN npm ci

# Kodları kopyala ve derle
COPY . .
RUN npm run build -- --configuration=production

# Stage 2: Serve stage
FROM nginx:alpine
COPY nginx.Production.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist/fluxify-web/browser /usr/share/nginx/html
EXPOSE 4200
CMD ["nginx", "-g", "daemon off;"]
